#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan;
        zmk,matrix_transform = &transform;
    };

    aliases {
        led-red = &led0;
        led-green = &led1;
        led-blue = &led2;
    };

    leds {
        compatible = "gpio-leds";
        status = "okay";
        led0: led_0 {
            gpios = <&pro_micro 9 GPIO_ACTIVE_LOW>;
        };
        led1: led_1 {
            gpios = <&pro_micro 16 GPIO_ACTIVE_LOW>;
        };
        led2: led_2 {
            gpios = <&pro_micro 10 GPIO_ACTIVE_LOW>;
        };
    };

    kscan: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";

        row-gpios = <&pro_micro 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

        col-gpios = <&pro_micro 15 (GPIO_ACTIVE_HIGH)>,
                    <&pro_micro 18 (GPIO_ACTIVE_HIGH)>,
                    <&pro_micro 19 (GPIO_ACTIVE_HIGH)>,
                    <&pro_micro 20 (GPIO_ACTIVE_HIGH)>,
                    <&pro_micro 21 (GPIO_ACTIVE_HIGH)>;
    };

    transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <7>;

        map = <
                     RC(0, 0) RC(0, 1) RC(0, 2) RC(0, 3) RC(0, 4)
                     RC(1, 0) RC(1, 1) RC(1, 2) RC(1, 3) RC(1, 4)
                     RC(2, 0) RC(2, 1) RC(2, 2) RC(2, 3) RC(2, 4)
                     RC(3, 0) RC(3, 1) RC(3, 2) RC(3, 3) RC(3, 4)
        >;
    };
};